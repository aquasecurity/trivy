<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.example</groupId>
        <artifactId>example-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>repos-from-parent-poms</artifactId>
    <version>1.0.0</version>

    <repositories>
        <repository>
            <id>root-repo</id>
            <url>REPO_ROOT_URL</url>
        </repository>
        <!-- overrides the repository with the same ID from the parent POM -->
        <repository>
            <id>overridden-repo</id>
            <url>REPO_ROOT_URL</url>
        </repository>
        <!-- disables the repository with the same ID from the parent POM -->
        <repository>
            <id>disabled-repo</id>
            <url>REPO_ROOT_URL</url>
            <releases>
                <enabled>false</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.example</groupId>
                <artifactId>example-bom</artifactId>
                <version>1.0.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.example</groupId>
            <artifactId>example-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.example</groupId>
            <artifactId>example-api2</artifactId>
        </dependency>
        <dependency>
            <groupId>org.example</groupId>
            <artifactId>example-api3</artifactId>
        </dependency>
        <dependency>
            <groupId>org.example</groupId>
            <artifactId>example-api4</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>org.example</groupId>
            <artifactId>example-api5</artifactId>
            <version>1.0.0</version>
        </dependency>
    </dependencies>
</project>
